APP_NAME="Inventário IT"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080
APP_LOCALE=pt
APP_TIMEZONE=Europe/Lisbon

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=inventario
DB_USERNAME=inventario
DB_PASSWORD=muda-esta-password

SESSION_DRIVER=file
SESSION_LIFETIME=480
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr

MAIL_MAILER=log
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=inventario@example.com
MAIL_FROM_NAME="Inventário IT"

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Admin

API_THROTTLE_PER_MINUTE=120
ENFORCE_SAME_COMPANY_CHECKOUT=true
